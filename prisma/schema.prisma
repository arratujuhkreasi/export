datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id        String   @id @default(cuid())
  invoiceNo String   @unique
  buyerName String
  amount    Float
  status    String   @default("DRAFT") // DRAFT, SENT, PAID, CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  product   String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id        String   @id @default(cuid())
  type      String   // SVLK, COO, PHYTO
  status    String   @default("PENDING") // PENDING, APPROVED, EXPIRED
  shipment  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}